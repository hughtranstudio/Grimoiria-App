{
  "$status": "DRAFT: not approved by Hugh. Nothing here ships until he says ship.",
  "$source": "HT Press house style (HT-Press-Vault, palace/archive/motion-wizard/source/references/house-style.md). Edit this file, then run tools/gen-tokens.py.",

  "palette": {
    "ink":          { "hex": "#000000", "use": "text and marks on light grounds" },
    "soot":         { "hex": "#141414", "use": "dark ground" },
    "paper":        { "hex": "#FFFFFF", "use": "light surface" },
    "vellum":       { "hex": "#F8F8F8", "use": "light ground" },
    "linen":        { "hex": "#F4F4F4", "use": "text on dark and night grounds" },
    "muted":        { "hex": "#6B6B6B", "use": "secondary text on light grounds" },
    "rubric":       { "hex": "#EB0303", "use": "marks, rules, illustration. The only thing that glows." },
    "rubricSmall":  { "hex": "#CC0000", "use": "red text under 24 pt on light grounds" },
    "rubricOnDark": { "hex": "#FF3232", "use": "red on dark and night grounds" },
    "beltane":      { "hex": "#010742", "use": "Beltane ultramarine night ground" },
    "beltaneDeep":  { "hex": "#00042C", "use": "night surface, one step under the ground" }
  },

  "retired": ["#B8442A", "#D42A1E", "#F5F1E8", "#F2EDE2", "#1A1815", "#1A1613", "#0A0806"],

  "fonts": {
    "title": { "family": "Cormorant Garamond", "file": "CormorantGaramond.ttf" },
    "text":  { "family": "EB Garamond", "file": "EBGaramond.ttf" },
    "glyph": { "family": "Physis", "note": "Hugh's own typeface for astrological glyphs. Not bundled yet." }
  },

  "type": {
    "$note": "Points. Garamonds sit small on screen, so text runs about 2 pt over Apple's sizes.",
    "caption": 12,
    "callout": 14,
    "body": 15,
    "headline": 16,
    "title3": 19,
    "title2": 23,
    "title": 30,
    "titleTracking": 0.14
  },

  "motion": {
    "arrive": { "curve": [0.16, 1, 0.3, 1], "seconds": 0.42, "note": "expo-out arrival" },
    "stamp":  { "curve": [0.7, 0, 0.84, 0], "seconds": 0.18, "note": "seal-stamp emphasis" }
  },

  "styles": {
    "system": {
      "name": "System",
      "summary": "Apple's look with your accent. Today's app.",
      "titleFont": null, "textFont": null, "labelFont": null,
      "titleCaps": false, "radius": null, "forceDark": false, "accentIsRubric": false,
      "light": {}, "dark": {}
    },
    "a": {
      "name": "A · Codex",
      "summary": "Full press. Vellum page, ink type, Garamond everywhere, square corners, red only for marks.",
      "titleFont": "title", "textFont": "text", "labelFont": "text",
      "titleCaps": true, "radius": 2, "forceDark": false, "accentIsRubric": true,
      "light": { "ground": "vellum", "surface": "paper", "ink": "ink", "muted": "muted",
                 "rule": "ink/0.14", "rubric": "rubric", "rubricText": "rubricSmall" },
      "dark":  { "ground": "ink", "surface": "soot", "ink": "linen", "muted": "linen/0.62",
                 "rule": "linen/0.16", "rubric": "rubricOnDark", "rubricText": "rubricOnDark" }
    },
    "b": {
      "name": "B · Marginalia",
      "summary": "Light touch. Apple's pages and labels, Garamond for titles and your writing, rubric accent.",
      "titleFont": "title", "textFont": "text", "labelFont": null,
      "titleCaps": false, "radius": null, "forceDark": false, "accentIsRubric": true,
      "light": { "rubric": "rubric", "rubricText": "rubricSmall" },
      "dark":  { "rubric": "rubricOnDark", "rubricText": "rubricOnDark" }
    },
    "c": {
      "name": "C · Beltane Night",
      "summary": "Night ground in Beltane ultramarine, linen type, red that glows. Always dark.",
      "titleFont": "title", "textFont": "text", "labelFont": "text",
      "titleCaps": true, "radius": 2, "forceDark": true, "accentIsRubric": true,
      "light": { "ground": "beltane", "surface": "beltaneDeep", "ink": "linen", "muted": "linen/0.66",
                 "rule": "linen/0.18", "rubric": "rubricOnDark", "rubricText": "rubricOnDark" },
      "dark":  { "ground": "beltane", "surface": "beltaneDeep", "ink": "linen", "muted": "linen/0.66",
                 "rule": "linen/0.18", "rubric": "rubricOnDark", "rubricText": "rubricOnDark" }
    }
  }
}
