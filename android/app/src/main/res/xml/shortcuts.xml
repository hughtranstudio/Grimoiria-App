<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_capture"
        android:shortcutId="record"
        android:shortcutLongLabel="@string/shortcut_record_long"
        android:shortcutShortLabel="@string/shortcut_record_short">
        <intent
            android:action="app.grimoiria.capture.RECORD"
            android:targetClass="app.grimoiria.capture.MainActivity"
            android:targetPackage="app.grimoiria.capture" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_capture"
        android:shortcutId="session"
        android:shortcutLongLabel="@string/shortcut_session_long"
        android:shortcutShortLabel="@string/shortcut_session_short">
        <intent
            android:action="app.grimoiria.capture.SESSION"
            android:targetClass="app.grimoiria.capture.MainActivity"
            android:targetPackage="app.grimoiria.capture" />
    </shortcut>
